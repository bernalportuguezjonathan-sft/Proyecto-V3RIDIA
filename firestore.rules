rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // El `exists()` no es de adorno: si la cuenta esta autenticada pero
    // todavia no tiene documento en `users` (por ejemplo justo antes de que
    // initializeUser lo autorrepare), `get()` devuelve null y leer `.data`
    // lanza un error de evaluacion que tumba la regla ENTERA. Es decir, en un
    // `isAdmin() || otraCosa` ni siquiera se llega a evaluar `otraCosa`, y a
    // esa persona se le niega algo a lo que si tenia derecho.
    //
    // Las llamadas a get()/exists() sobre el mismo documento dentro de una
    // misma peticion se cachean, asi que anadir el exists() no duplica la
    // lectura facturada.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'Administrador';
    }

    // Un Explorador nunca puede leer esto. isAdminCodeValid() sí puede,
    // porque get() dentro de las reglas ignora el permiso de lectura del
    // documento. Un admin puede leerlo/cambiarlo desde la consola de
    // Firebase para rotar el código sin tocar el código de la app.
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    function isAdminCodeValid(code) {
      return code ==
        get(/databases/$(database)/documents/config/secrets).data.adminCode;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Crear tu propio perfil como Administrador exige el código correcto;
      // el código real vive solo en config/secrets, nunca en la app.
      allow create: if isOwner(userId) &&
        (request.resource.data.role != 'Administrador' ||
          isAdminCodeValid(request.resource.data.adminCode));
      function camposTocados() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Un Explorador puede tocar su nombre/foto de perfil y sus tokens (los
      // otorga la app al completar desafíos y los descuenta al canjear
      // recompensas). Subirlos está acotado a 1000 por escritura para que
      // auto-asignarse Veridiums escribiendo directo a Firestore no sea
      // trivial; bajarlos es libre porque solo se perjudica a sí mismo. Su
      // rol nunca es editable por el propio dueño.
      //
      // NOTA (2026-08-26): esto vuelve a permitir que el CLIENTE suba sus
      // propios tokens, de forma temporal, porque `registrarFoto` en
      // `services/repositorio_d.dart` corre otra vez en el cliente mientras
      // el proyecto no tenga el plan Blaze de Firebase activo. La versión
      // dura de esta regla (que solo deja bajar tokens) está pensada para
      // cuando las Cloud Functions estén desplegadas — ver
      // [[project-veridia-backend]] en la memoria del proyecto.
      //
      // `tokensTotales` es el acumulado historico del que salen el nivel y el
      // ranking: solo puede SUBIR. Si se pudiera bajar, cualquiera se
      // reescribiria el recorrido; si se pudiera subir sin limite, se
      // regalaria niveles. Sube acotado igual que el saldo.
      //
      // `mascotaActiva` y `accesorios` son cosmeticos y no mueven dinero, asi
      // que el dueno los escribe libremente. Lo unico que hay que impedir es
      // que se cuelen en la misma escritura que toca los Veridiums.
      //
      // `marcoEquipado` y `tituloEquipado` son igual de cosmeticos: guardan
      // CUAL de las recompensas ya compradas lleva puesta. No dan nada que no
      // se tenga —el perfil solo pinta lo que aparezca en sus canjes—, asi
      // que escribir aqui un id que no se ha comprado no regala nada: la app
      // lo ignora al resolver que mostrar.
      function soloEditaSuPerfil() {
        return camposTocados().hasOnly([
            'displayName', 'photoURL', 'tokens', 'tokensTotales',
            'mascotaActiva', 'accesorios',
            'marcoEquipado', 'tituloEquipado'
          ]) &&
          (!camposTocados().hasAny(['tokens']) ||
            (request.resource.data.tokens is int &&
              request.resource.data.tokens >= 0 &&
              request.resource.data.tokens <= resource.data.tokens + 1000)) &&
          (!camposTocados().hasAny(['tokensTotales']) ||
            (request.resource.data.tokensTotales is int &&
              request.resource.data.tokensTotales >=
                resource.data.get('tokensTotales', 0) &&
              request.resource.data.tokensTotales <=
                resource.data.get('tokensTotales', 0) + 1000));
      }

      // Suspensión temporal cuyo plazo ya pasó.
      function suspensionVencida() {
        return resource.data.get('isBanned', false) == true &&
          resource.data.get('banExpires', null) != null &&
          resource.data.banExpires < request.time;
      }

      // Al entrar, la app levanta sola una suspensión ya cumplida (ver
      // UserRepository.initializeUser). Solo permite LEVANTARLA: nadie puede
      // ponerse ni prolongarse un baneo por esta vía.
      function soloLevantaSuSuspension() {
        return camposTocados().hasOnly(['isBanned', 'banExpires', 'banReason']) &&
          request.resource.data.isBanned == false &&
          request.resource.data.get('banExpires', null) == null;
      }

      allow update: if isAdmin() ||
        (isOwner(userId) && soloEditaSuPerfil()) ||
        (isOwner(userId) && suspensionVencida() && soloLevantaSuSuspension());
      allow delete: if isAdmin();

      // Huellas de las fotos ya usadas por este explorador (sha256 + ahash).
      // Solo se pueden AÑADIR: si se pudieran borrar o reescribir, bastaría
      // con eliminar la huella para volver a subir la misma foto y cobrar
      // dos veces el mismo avistamiento.
      //
      // NOTA (2026-08-26): el cliente vuelve a escribir aquí directamente de
      // forma temporal (ver nota en soloEditaSuPerfil() arriba).
      match /fotos/{huella} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Progreso PERSONAL en cada desafío. Vive aquí y no dentro del desafío
      // porque es privado: nadie más lo lee ni lo mueve, y un desafío global
      // avanza distinto en cada cuenta.
      //
      // NOTA (2026-08-26): el cliente vuelve a escribir aquí directamente de
      // forma temporal (ver nota en soloEditaSuPerfil() arriba).
      match /desafios/{challengeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) &&
          request.resource.data.progreso is int &&
          request.resource.data.progreso >= 0;
      }

      // Lo comprado en el Refugio: mascotas y accesorios. El id del documento
      // es el id del catalogo, asi que comprar dos veces lo mismo reescribe
      // el mismo documento en vez de cobrar dos veces.
      //
      // No se puede BORRAR: un cosmetico comprado es del explorador para
      // siempre, y ademas borrarlo seria la forma de volver a comprarlo (y de
      // volver a gastarse los Veridiums sin ganar nada, o de romper el
      // recuento si algun dia hay reembolsos).
      //
      // NOTA (2026-08-26): el cliente escribe aqui directamente de forma
      // temporal, igual que en el resto de la economia (ver la nota en
      // soloEditaSuPerfil() arriba). Con Blaze activo esto pasa a
      // `allow write: if false` y solo lo toca el Admin SDK.
      match /inventario/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          request.resource.data.costo is int &&
          request.resource.data.costo >= 0;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Libro de movimientos de Veridiums. Es el registro de POR QUE cambio
      // el saldo, y su id es la clave de idempotencia del hecho que se pago
      // (ver claveMovimiento en lib/services/economia.dart).
      //
      // Inmutable: si un apunte se pudiera reescribir o borrar, el mismo
      // hecho podria cobrarse dos veces y el libro dejaria de servir para
      // auditar nada.
      match /movimientos/{opId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          request.resource.data.delta is int;
        allow update, delete: if false;
      }
    }

    // Recompensas canjeadas. El explorador crea las suyas (el descuento de
    // Veridiums va en la misma transacción) y solo un administrador puede
    // marcarlas como entregadas o borrarlas.
    match /canjes/{canjeId} {
      // El `resource == null` NO es cosmetico: es lo que hace que canjear
      // funcione la primera vez.
      //
      // canjear() en repositorio_r.dart abre una transaccion que empieza
      // leyendo canjes/{uid}_{recompensaId} para saber si esa recompensa ya
      // se canjeo. Ese documento NO EXISTE la primera vez, y en un `get`
      // sobre un documento inexistente Firestore evalua la regla con
      // `resource` a null: `resource.data.userId` revienta, la regla se
      // resuelve como falsa y devuelve permission-denied. La transaccion
      // lanzaba, caia en el catch y el explorador veia "No se pudo completar
      // el canje" SIEMPRE, en todas las recompensas no repetibles.
      //
      // Dejar leer un documento que no existe no filtra nada: no hay datos
      // que devolver. Y la comprobacion de dueno sigue intacta para los que
      // si existen.
      // El dueno va PRIMERO y isAdmin() despues: isAdmin() cuesta una lectura
      // facturada de `users/{uid}`, y el caso normal —un explorador leyendo
      // sus propios canjes— se resuelve sin llegar a ella.
      allow read: if (isSignedIn() &&
          (resource == null || resource.data.userId == request.auth.uid)) ||
        isAdmin();
      // Nacen siempre 'activo': ya no hay aprobación del administrador, la
      // recompensa se entrega en el mismo momento del pago.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.costo is int &&
        request.resource.data.costo >= 0 &&
        request.resource.data.estado == 'activo';
      allow update, delete: if isAdmin();
    }

    // Un avistamiento es lo ÚNICO de esta base de datos que ven todos los
    // demás exploradores, y una vez en el mapa no hay quien lo depure uno por
    // uno. Por eso es la colección con la validación más estricta.
    //
    // Hasta el 2026-09-17 el `create` solo comprobaba que el userId fuera el
    // de quien escribe: ni campos obligatorios, ni tipos, ni topes de tamaño.
    // El filtro que decide si una foto es de verdad una especie (ver
    // `evaluarRespuestaIA` en lib/services/especie_ia_service.dart) vivía
    // entonces SOLO en la app, así que un cliente modificado escribía lo que
    // quisiera y del tamaño que quisiera. Esto lo cierra desde el servidor,
    // que es el único sitio donde un filtro no se puede evitar.
    function avistamientoValido() {
      let d = request.resource.data;
      // `get(campo, null)` y no `d.campo`: los opcionales pueden llegar como
      // null explícito o no llegar, y leer una clave ausente hace fallar la
      // regla entera en vez de dar null.
      let imagePath = d.get('imagePath', null);
      let type = d.get('type', null);
      let nombreAutor = d.get('userDisplayName', null);
      let lat = d.get('latitude', null);
      let lng = d.get('longitude', null);

      return d.keys().hasOnly([
          'commonName', 'scientificName', 'location', 'notes', 'dateTime',
          'imagePath', 'latitude', 'longitude', 'type',
          'userId', 'userDisplayName'
        ]) &&
        d.keys().hasAll([
          'commonName', 'scientificName', 'location', 'notes', 'dateTime',
          'userId'
        ]) &&
        // Nadie publica en nombre de otro.
        d.userId == request.auth.uid &&
        // Los topes son lo que impide engordar la base de datos a propósito:
        // sin ellos, un solo documento puede llevar un megabyte de texto.
        d.commonName is string && d.commonName.size() > 0 &&
          d.commonName.size() <= 120 &&
        d.scientificName is string && d.scientificName.size() <= 160 &&
        d.location is string && d.location.size() <= 200 &&
        d.notes is string && d.notes.size() <= 500 &&
        d.dateTime is string && d.dateTime.size() <= 40 &&
        (imagePath == null ||
          (imagePath is string && imagePath.size() <= 500)) &&
        (type == null || (type is string && type.size() <= 40)) &&
        (nombreAutor == null ||
          (nombreAutor is string && nombreAutor.size() <= 120)) &&
        // Coordenadas dentro del planeta: un punto imposible rompe el mapa
        // para todos, no solo para quien lo escribió.
        (lat == null || (lat is number && lat >= -90 && lat <= 90)) &&
        (lng == null || (lng is number && lng >= -180 && lng <= 180));
    }

    match /avistamientos/{sightingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && avistamientoValido();

      // El dueño NO puede editar: podría guardar una foto que la IA aprobó y
      // reescribirle después la especie, saltándose el filtro entero sin
      // tocar el cliente. Nada en la app actualiza avistamientos
      // (`updateObservation` en repositorio_o.dart no lo llama nadie), así
      // que cerrarlo no quita ninguna función; queda solo para moderación.
      allow update: if isAdmin();

      // Borrar el propio avistamiento SÍ: es lo que hace el Diario
      // (historial.dart) y solo afecta a datos de quien lo borra.
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // El desafío solo guarda su DEFINICIÓN; el progreso de cada explorador
      // está en users/{uid}/desafios. Lo único que un Explorador puede tocar
      // aquí es el contador de cuántos lo han completado, y solo sumando de
      // uno en uno cuando el desafío es suyo o global.
      //
      // NOTA (2026-08-26): el cliente vuelve a poder tocar este contador de
      // forma temporal (ver nota en soloEditaSuPerfil() arriba).
      // Igual que en canjes: el camino del explorador va primero para no
      // pagar la lectura de isAdmin() en el caso normal.
      allow update: if (isSignedIn() &&
          (resource.data.get('assignedToUserId', null) == null ||
            resource.data.get('assignedToUserId', null) == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completadoPor']) &&
          request.resource.data.completadoPor ==
            resource.data.get('completadoPor', 0) + 1) ||
        isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read, write: if isAdmin();
    }
  }
}
